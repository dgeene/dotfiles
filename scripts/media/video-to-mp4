#!/usr/bin/env python3
"""Convert legacy videos to browser-friendly H.264/AAC fast-start MP4 files."""

import argparse
import json
import os
from pathlib import Path
import platform
import shlex
import shutil
import subprocess
import sys
import tempfile


EXTENSIONS = {'.flv', '.webm', '.avi', '.wmv', '.asf', '.wma', '.mp4', '.m4v',
              '.mov', '.mkv', '.mpg', '.mpeg', '.vob', '.3gp', '.ts', '.m2ts', '.ogv'}
BASE = ['ffmpeg', '-hide_banner', '-loglevel', 'error', '-nostdin', '-n', '-xerror']


def probe(path):
    result = subprocess.run(['ffprobe', '-v', 'error', '-show_streams', '-of', 'json',
                             str(path)], check=True, capture_output=True, text=True)
    return json.loads(result.stdout)['streams']


def streams_for(path):
    streams = probe(path)
    video = next((s for s in streams if s['codec_type'] == 'video'
                  and not s.get('disposition', {}).get('attached_pic')), None)
    audio = next((s for s in streams if s['codec_type'] == 'audio'), None)
    if video is None and audio is None:
        raise ValueError('No video or audio stream found')
    if video and video.get('color_transfer') in ('smpte2084', 'arib-std-b67'):
        raise ValueError('HDR input needs a separate tone-mapping workflow; this command targets SDR')
    return video, audio


def inputs(path, recursive):
    if path.is_file():
        return [path]
    if not path.is_dir():
        raise ValueError(f'Not a file or directory: {path}')
    found = []
    def onerror(error):
        raise error
    for directory, dirs, files in os.walk(path, followlinks=False, onerror=onerror):
        parent = Path(directory)
        dirs[:] = sorted(d for d in dirs if recursive and not d.startswith('.video-to-mp4-')
                         and not (parent / d).is_symlink())
        found.extend(parent / name for name in sorted(files)
                     if Path(name).suffix.lower() in EXTENSIONS
                     and not name.lower().endswith('.web.mp4')
                     and not (parent / name).is_symlink())
    return found


def amd_device(requested):
    if platform.system() != 'Linux':
        raise ValueError('AMD encoding uses VA-API on Linux; use --encoder cpu on this OS')
    devices = [Path(requested)] if requested else sorted(Path('/dev/dri').glob('renderD*'))
    for device in devices:
        vendor = Path('/sys/class/drm') / device.name / 'device/vendor'
        if (device.exists() and vendor.is_file()
                and vendor.read_text().strip().lower() == '0x1002'):
            return str(device)
    raise ValueError('No AMD render device found; check drivers or pass --device /dev/dri/renderD...')


def encoder_options(args):
    quality = str(args.quality)
    if args.encoder == 'cpu':
        return [], ['-c:v', 'libx264', '-preset', args.preset or 'medium',
                    '-crf', quality, '-pix_fmt', 'yuv420p'], ''
    if args.encoder == 'nvidia':
        options = ['-c:v', 'h264_nvenc', '-preset', 'p5', '-rc', 'vbr',
                   '-cq', quality, '-b:v', '0', '-pix_fmt', 'yuv420p']
        if args.device is not None:
            if not args.device.isdigit():
                raise ValueError('NVIDIA --device must be a nonnegative GPU index, such as 0')
            options += ['-gpu', args.device]
        return [], options, ''
    device = amd_device(args.device)
    return ['-vaapi_device', device], ['-c:v', 'h264_vaapi', '-rc_mode', 'CQP',
                                      '-qp', quality], ',format=nv12,hwupload'


def command(source, output, video, audio, args, encoder):
    setup, options, upload = encoder
    cmd = BASE + (setup if video else []) + ['-i', str(source)]
    if video:
        # The scale filter adjusts SAR to retain display aspect ratio. For even
        # dimensions this is a no-op; 4:2:0 needs both dimensions to be even.
        filters = ('bwdif=mode=send_frame,' if args.deinterlace else '')
        filters += 'scale=ceil(iw/2)*2:ceil(ih/2)*2:flags=lanczos' + upload
        cmd += ['-map', f'0:{video["index"]}', '-vf', filters] + options
        cmd += ['-profile:v', 'high', '-tag:v', 'avc1', '-fps_mode', 'passthrough']
    else:
        cmd += ['-vn']
    if audio:
        cmd += ['-map', f'0:{audio["index"]}', '-c:a', 'aac', '-profile:a', 'aac_low',
                '-b:a', f'{args.audio_bitrate}k', '-ac', '2', '-ar', '48000']
    else:
        cmd += ['-an']
    return cmd + ['-sn', '-dn', '-map_metadata', '-1', '-map_chapters', '-1',
                  '-movflags', '+faststart', str(output)]


def check_encoder(encoder):
    setup, options, upload = encoder
    # Encoder listing alone does not establish that a GPU/driver actually works.
    subprocess.run(BASE + setup + ['-f', 'lavfi', '-i', 'color=size=128x128:rate=1',
                   '-vf', 'format=yuv420p' + upload, '-frames:v', '1'] + options
                   + ['-f', 'null', '-'], check=True)


def verify(path, video, audio):
    streams = probe(path)
    videos = [s for s in streams if s['codec_type'] == 'video']
    audios = [s for s in streams if s['codec_type'] == 'audio']
    if bool(videos) != bool(video) or bool(audios) != bool(audio):
        raise ValueError('Output is missing an expected stream')
    if videos and (videos[0]['codec_name'] != 'h264' or videos[0]['pix_fmt'] != 'yuv420p'):
        raise ValueError('Output is not 8-bit 4:2:0 H.264')
    if audios and audios[0]['codec_name'] != 'aac':
        raise ValueError('Output audio is not AAC')
    subprocess.run(BASE + ['-i', str(path), '-map', '0:v?', '-map', '0:a?',
                          '-f', 'null', '-'], check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog=
        'Requires Python 3.8+, ffmpeg and ffprobe. Originals stay unchanged. '
        'Directory scans skip symlinks and *.web.mp4. Existing outputs are skipped. '
        'Only the first video and audio streams are retained; subtitles are omitted.')
    parser.add_argument('path', nargs='?', type=Path, default=Path('.'),
                        help='file or directory (default: current directory)')
    parser.add_argument('-r', '--recursive', action='store_true', help='include subdirectories')
    parser.add_argument('-o', '--output', type=Path, help='output path for one file (default: NAME.web.mp4)')
    parser.add_argument('--encoder', choices=['cpu', 'nvidia', 'amd'], default='cpu')
    parser.add_argument('--device', help='NVIDIA GPU index or AMD render device (default: auto-detect)')
    parser.add_argument('-q', '--quality', type=int, choices=range(1, 52), default=20,
                        metavar='1-51', help='lower is better/larger (default: 20); scales differ by encoder')
    parser.add_argument('--preset', choices=['ultrafast', 'superfast', 'veryfast', 'faster',
                        'fast', 'medium', 'slow', 'slower', 'veryslow'], help='CPU speed preset (default: medium)')
    parser.add_argument('--audio-bitrate', type=int, default=160, metavar='KBPS',
                        help='stereo AAC bitrate (default: 160)')
    parser.add_argument('--deinterlace', action='store_true', help='deinterlace old interlaced recordings')
    parser.add_argument('-n', '--dry-run', action='store_true', help='probe inputs and print commands; write nothing')
    args = parser.parse_args()
    if not 32 <= args.audio_bitrate <= 512:
        parser.error('--audio-bitrate must be between 32 and 512 kbps')
    if args.device and args.encoder == 'cpu':
        parser.error('--device requires --encoder nvidia or amd')
    if args.preset and args.encoder != 'cpu':
        parser.error('--preset applies only to CPU encoding')
    source = args.path.expanduser().absolute()
    if args.output and not source.is_file():
        parser.error('--output requires a single input file')
    for tool in ('ffmpeg', 'ffprobe'):
        if not shutil.which(tool):
            parser.error(f'{tool} is required but was not found on PATH')
    files = inputs(source, args.recursive)
    counts = dict(converted=0, planned=0, skipped=0, failed=0)
    encoder = None
    for path in files:
        output = (args.output.expanduser().absolute() if args.output
                  else path.with_name(path.stem + '.web.mp4'))
        try:
            if output == path or output.suffix.lower() != '.mp4':
                raise ValueError('Output must be a separate .mp4 path')
            if os.path.lexists(output):
                print(f'SKIP (destination exists): {output}')
                counts['skipped'] += 1
                continue
            if not output.parent.is_dir():
                raise ValueError(f'Output directory does not exist: {output.parent}')
            before = path.stat()
            video, audio = streams_for(path)
            if video and encoder is None:
                encoder = encoder_options(args)
                if not args.dry_run:
                    try:
                        check_encoder(encoder)
                    except subprocess.CalledProcessError as error:
                        raise RuntimeError(f'{args.encoder} encoder unavailable; check FFmpeg/drivers '
                                           'or select --encoder cpu') from error
            selected = encoder or ([], [], '')
            print(f'{path} -> {output}', flush=True)
            if video and (video['width'] % 2 or video['height'] % 2):
                print('NOTE: rounding odd dimensions up to even; preserving display aspect ratio.')
            if not video:
                print('NOTE: audio-only input; creating AAC audio in MP4.')
            if args.dry_run:
                print(shlex.join(command(path, output, video, audio, args, selected)))
                counts['planned'] += 1
                continue
            with tempfile.TemporaryDirectory(prefix='.video-to-mp4-', dir=output.parent) as directory:
                pending = Path(directory) / 'output.mp4'
                subprocess.run(command(path, pending, video, audio, args, selected), check=True)
                verify(pending, video, audio)
                after = path.stat()
                if any(getattr(before, field) != getattr(after, field)
                       for field in ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns')):
                    raise ValueError('Source changed during conversion; output not published')
                # Atomic no-clobber publication on the destination filesystem.
                os.link(pending, output)
            counts['converted'] += 1
            print(f'Created {output} ({output.stat().st_size / 1048576:.2f} MiB)', flush=True)
        except (OSError, ValueError, subprocess.CalledProcessError) as error:
            counts['failed'] += 1
            print(f'ERROR: {path}: {error}', file=sys.stderr)
    print('Summary: ' + ', '.join(f'{value} {key}' for key, value in counts.items()))
    return int(bool(counts['failed']))


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f'ERROR: {error}', file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
