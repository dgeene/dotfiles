#!/usr/bin/env python3
"""
Download a Hugging Face model, sync it to NAS storage, or package it as a
local tar archive with a SHA-256 checksum.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tarfile
from contextlib import contextmanager
from dataclasses import dataclass, replace
from datetime import datetime, timezone
from fnmatch import fnmatchcase
from pathlib import Path
from typing import Iterable
from urllib.parse import quote, urlsplit


DEFAULT_NAS_ROOT = "/mnt/ai-models"
DEFAULT_LOCAL_ROOT = str(Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "hf-model-archives")
PROVENANCE_DIR = "archive-provenance"
SNAPSHOT = f"{PROVENANCE_DIR}/snapshot.json"
MODEL_LAYOUTS = {"source": Path("source/huggingface"), "gguf": Path("inference/gguf")}


@dataclass(frozen=True)
class ArchivePaths:
    local_model: Path
    nas_model: Path
    checksum: Path
    local_archive: Path
    local_archive_checksum: Path
    local_checksum: Path


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Download a Hugging Face model, sync it to a NAS with rsync, "
            "or package it as a local tar archive with a SHA-256 checksum."
        ),
        epilog="Authentication: set HF_TOKEN in the environment for private or gated models.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.add_argument(
        "hf_repo",
        help="Hugging Face repository ID, for example Qwen/Qwen3-8B.",
    )
    parser.add_argument(
        "model_name",
        nargs="?",
        help=(
            "Destination directory name. Defaults to the final component of "
            "the Hugging Face repository ID."
        ),
    )

    stage_group = parser.add_argument_group("stage selection")
    stage_group.add_argument(
        "--all",
        action="store_true",
        help="Run the standard download, sync, and NAS checksum stages.",
    )
    stage_group.add_argument(
        "--download",
        action="store_true",
        help="Download at a pinned commit, bundle provenance JSON, and write local SHA-256 checksums.",
    )
    stage_group.add_argument(
        "--sync",
        action="store_true",
        help="Sync the local model directory to the NAS with rsync.",
    )
    stage_group.add_argument(
        "--checksum",
        action="store_true",
        help="Verify the NAS snapshot and create missing checksums; never replace an existing baseline.",
    )
    stage_group.add_argument(
        "--archive",
        action="store_true",
        help="Create and verify an optional local tar archive (--compression none or zstd).",
    )
    stage_group.add_argument(
        "--archive-checksum",
        action="store_true",
        help="Generate a SHA-256 checksum for an existing local tar archive.",
    )
    stage_group.add_argument(
        "--no-archive-checksum",
        action="store_true",
        help="Do not automatically checksum the tar archive created by --archive.",
    )

    path_group = parser.add_argument_group("paths")
    path_group.add_argument(
        "--layout",
        choices=("auto", "source", "gguf"),
        default="auto",
        help=(
            "Storage layout: auto uses inference/gguf for GGUF-only weights and "
            "source/huggingface otherwise. Offline stages locate existing organized "
            "directories; select a layout if both exist. Does not filter downloads."
        ),
    )
    path_group.add_argument(
        "--nas-root",
        type=Path,
        default=Path(os.environ.get("AI_MODELS_NAS_ROOT", DEFAULT_NAS_ROOT)),
        help="Root of the NAS model archive.",
    )
    path_group.add_argument(
        "--local-root",
        type=Path,
        default=Path(os.environ.get("HF_MODEL_DOWNLOAD_ROOT", DEFAULT_LOCAL_ROOT)),
        help="Root directory for local model downloads.",
    )
    path_group.add_argument(
        "--local-model-dir",
        type=Path,
        help=(
            "Exact new download directory or existing sealed snapshot for offline stages. "
            "With --record-conversion, the existing GGUF output directory to import."
        ),
    )
    path_group.add_argument(
        "--archive-dir",
        type=Path,
        help=(
            "Directory for local tar archives. Defaults to the local model "
            "directory's parent."
        ),
    )
    path_group.add_argument(
        "--archive-path",
        type=Path,
        help=(
            "Specific local tar archive path. Defaults to "
            "<archive-dir>/<model-name>-<commit>[-<conversion>].tar[.zst]."
        ),
    )

    download_group = parser.add_argument_group("download options")
    download_group.add_argument(
        "--revision",
        help="Download branch/tag/commit; offline stages require the full commit SHA.",
    )
    download_group.add_argument(
        "--include",
        action="append",
        default=[],
        metavar="PATTERN",
        help="File pattern to include during hf download. May be passed multiple times.",
    )
    download_group.add_argument(
        "--exclude",
        action="append",
        default=[],
        metavar="PATTERN",
        help="File pattern to exclude during hf download. May be passed multiple times.",
    )
    download_group.add_argument(
        "--force-download",
        action="store_true",
        help="Pass --force-download to hf download.",
    )
    download_group.add_argument(
        "--limit",
        action="store_true",
        help="Limit hf download concurrency by passing --max-workers 1.",
    )
    download_group.add_argument(
        "--max-workers",
        type=int,
        help="Pass --max-workers to hf download.",
    )

    rsync_group = parser.add_argument_group("sync options")
    rsync_group.add_argument(
        "--rsync-delete",
        action="store_true",
        help="Retired: rejected because snapshots are immutable.",
    )

    stage_group.add_argument("--verify", action="store_true", help="Verify a published snapshot against its saved checksums.")
    stage_group.add_argument("--verify-target", choices=("local", "nas", "backup"), default="nas")
    stage_group.add_argument("--record-conversion", type=Path, metavar="RECIPE.json", help="Import existing GGUF outputs and preserve a conversion recipe (never executes it).")
    stage_group.add_argument("--verify-archive", action="store_true", help="Verify archive checksum and all embedded snapshot file hashes without extracting.")
    path_group.add_argument("--backup-root", type=Path, help="Also publish a verified independent directory copy beneath this existing root.")
    path_group.add_argument("--conversion-name", help="Select a locally converted artifact for offline stages.")
    path_group.add_argument("--compression", choices=("none", "zstd"), default="zstd", help="Optional tar packaging compression.")
    download_group.add_argument("--skip-upstream-verification", action="store_true", help="Skip hf cache verify; local and transfer checks remain mandatory.")
    download_group.add_argument("--require-source-complete", action="store_true", help="Fail on source readiness warnings; does not certify converter support.")
    download_group.add_argument("--base-model-dir", action="append", type=Path, default=[], help="Verified base-model snapshot dependency; repeat for multiple bases.")

    args = parser.parse_args()

    selected_stages = [
        args.download,
        args.sync,
        args.checksum,
        args.archive,
        args.archive_checksum,
        args.verify,
        args.record_conversion,
        args.verify_archive,
    ]
    if args.all and any(selected_stages):
        parser.error(
            "--all cannot be combined with --download, --sync, --checksum, "
            "--archive, or --archive-checksum"
        )
    if args.max_workers is not None and args.max_workers < 1:
        parser.error("--max-workers must be greater than 0")
    if args.limit and args.max_workers is not None:
        parser.error("--limit cannot be combined with --max-workers")
    if args.no_archive_checksum and not args.archive:
        parser.error("--no-archive-checksum requires --archive")
    if args.archive_dir and args.archive_path:
        parser.error("--archive-dir cannot be combined with --archive-path")
    if args.rsync_delete:
        parser.error("--rsync-delete is incompatible with immutable snapshots; use a separate snapshot")
    if args.record_conversion and (args.download or args.all or not args.local_model_dir):
        parser.error("--record-conversion requires --local-model-dir and cannot be combined with download")
    if args.conversion_name and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", args.conversion_name):
        parser.error("--conversion-name must be a simple directory name")
    if args.verify_target == "backup" and not args.backup_root:
        parser.error("--verify-target backup requires --backup-root")
    if not re.fullmatch(r"[\w.-]+/[\w.-]+", args.hf_repo) or any(
        part in {".", ".."} for part in args.hf_repo.split("/")
    ):
        parser.error("hf_repo must be an owner/repository ID, not a URL or file path")
    if args.model_name and (
        args.model_name in {".", ".."} or "/" in args.model_name or "\\" in args.model_name
    ):
        parser.error("model_name must be a single directory name")

    return args


def selected_stages(args: argparse.Namespace) -> set[str]:
    if args.all or not (
        args.download
        or args.sync
        or args.checksum
        or args.archive
        or args.archive_checksum
        or args.verify
        or args.record_conversion
        or args.verify_archive
    ):
        return {"download", "sync", "checksum"}

    stages: set[str] = set()
    if args.download:
        stages.add("download")
    if args.sync:
        stages.add("sync")
    if args.checksum:
        stages.add("checksum")
    if args.archive:
        stages.add("archive")
        if not args.no_archive_checksum:
            stages.add("archive_checksum")
    if args.archive_checksum:
        stages.add("archive_checksum")
    if args.verify:
        stages.add("verify")
    if args.record_conversion:
        stages.add("conversion")
    if args.verify_archive:
        stages.add("verify_archive")
    return stages


def repo_org(hf_repo: str) -> str:
    return hf_repo.split("/", 1)[0]


def default_model_name(hf_repo: str) -> str:
    return hf_repo.rstrip("/").split("/")[-1]


def resolve_path(path: Path) -> Path:
    return path.expanduser().resolve()


def build_paths(args: argparse.Namespace, model_name: str, layout: str = "source") -> ArchivePaths:
    org = repo_org(args.hf_repo)
    relative = MODEL_LAYOUTS[layout] / org / model_name
    commit = getattr(args, "snapshot_commit", None) or args.revision
    if not commit or not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise SystemExit("ERROR: offline stages require --revision with a full commit SHA (or a sealed --local-model-dir)")
    relative /= commit
    if layout == "gguf":
        relative /= args.conversion_name or "download"
    checksum_relative = Path("metadata/checksums") / relative.parent / f"{relative.name}.sha256"
    local_model = (
        args.local_model_dir
        if args.local_model_dir is not None
        else args.local_root / relative
    )
    nas_model = args.nas_root / relative
    checksum = args.nas_root / checksum_relative
    archive_dir = args.archive_dir if args.archive_dir else local_model.parent
    extension = ".tar.zst" if args.compression == "zstd" else ".tar"
    artifact = f"-{relative.name}" if layout == "gguf" else ""
    local_archive = args.archive_path if args.archive_path else archive_dir / f"{model_name}-{commit}{artifact}{extension}"
    local_archive_checksum = Path(f"{local_archive}.sha256")

    paths = ArchivePaths(
        local_model=resolve_path(local_model),
        nas_model=resolve_path(nas_model),
        checksum=resolve_path(checksum),
        local_archive=resolve_path(local_archive),
        local_archive_checksum=resolve_path(local_archive_checksum),
        local_checksum=resolve_path(args.local_root / checksum_relative),
    )
    for root, manifest in ((paths.local_model, paths.local_checksum), (paths.nas_model, paths.checksum)):
        if manifest.is_relative_to(root):
            raise SystemExit("ERROR: checksum files must be outside snapshot directories; choose a separate --local-root")
    return paths


def infer_layout(names: Iterable[str]) -> str:
    kinds = {file_format(name)["model_kind"] for name in names}
    if kinds & {"gguf", "quantized_gguf"} and "source_format_weights" not in kinds:
        return "gguf"
    return "source"


def local_file_names(root: Path) -> Iterable[str]:
    return (
        path.relative_to(root).as_posix() for path in iter_files(root)
        if path.relative_to(root).parts[0] not in {".cache", PROVENANCE_DIR}
    )


def choose_layout(args: argparse.Namespace, stages: set[str], model_name: str,
                  info: dict | None = None) -> str:
    if args.layout != "auto":
        layout = args.layout
    elif info is not None:
        layout = infer_layout(selected_repo_files(info, args))
    elif args.local_model_dir is not None and stages & {"sync", "archive", "verify"}:
        layout = infer_layout(local_file_names(resolve_path(args.local_model_dir)))
    elif stages <= {"archive_checksum", "verify_archive"} and args.archive_path:
        # An explicitly located archive does not depend on the model layout.
        layout = "source"
    else:
        candidates = []
        for candidate in MODEL_LAYOUTS:
            paths = build_paths(args, model_name, candidate)
            if stages & {"sync", "archive"}:
                exists = paths.local_model.is_dir()
            elif "checksum" in stages:
                exists = paths.nas_model.is_dir()
            elif "verify" in stages:
                root = paths.local_model if args.verify_target == "local" else paths.nas_model
                if args.verify_target == "backup":
                    root = resolve_path(args.backup_root) / paths.nas_model.relative_to(resolve_path(args.nas_root))
                exists = root.is_dir()
            else:
                exists = paths.local_archive.is_file()
            if exists:
                candidates.append(candidate)
        if len(candidates) > 1:
            raise SystemExit("ERROR: both layouts exist; choose --layout source or --layout gguf")
        layout = candidates[0] if candidates else "source"

    if layout == "gguf":
        paths = build_paths(args, model_name, layout)
        names = list(selected_repo_files(info, args)) if info is not None else []
        # Avoid mixing source weights into an existing inference directory.
        for root in (paths.local_model, paths.nas_model):
            if root.is_dir():
                names.extend(local_file_names(root))
        if any(file_format(name)["model_kind"] == "source_format_weights" for name in names):
            raise SystemExit(
                "ERROR: source-format weights found in selection or directory; "
                "use --layout source or a separate GGUF-only selection/directory"
            )
    return layout


def print_section(title: str) -> None:
    print()
    print("=" * 40)
    print(title)
    print("=" * 40)


def require_command(command: str) -> None:
    if shutil.which(command) is None:
        raise SystemExit(f"ERROR: {command} is required but was not found in PATH")


def run_command(command: list[str]) -> None:
    sys.stdout.flush()
    subprocess.run(command, check=True)


def read_json(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(value, dict):
            raise ValueError("expected an object")
        return value
    except (OSError, ValueError) as error:
        raise SystemExit(f"ERROR: cannot read JSON object: {path}: {error}") from error


def write_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("x", encoding="utf-8") as output:
        json.dump(value, output, indent=2, ensure_ascii=False)
        output.write("\n")


def inventory(root: Path) -> dict[str, str]:
    return {p.relative_to(root).as_posix(): sha256_file(p) for p in iter_files(root)}


def verify_snapshot(root: Path, expected: dict[str, str] | None = None) -> dict:
    manifest = read_json(root / SNAPSHOT)
    if (manifest.get("schema_version") != 1 or not isinstance(manifest.get("files"), dict)
            or not manifest["files"] or not isinstance(manifest.get("repository_commit"), str)
            or not re.fullmatch(r"[0-9a-f]{40}", manifest["repository_commit"])
            or manifest.get("layout") not in MODEL_LAYOUTS
            or not isinstance(manifest.get("repository"), str)):
        raise SystemExit(f"ERROR: invalid snapshot manifest: {root}")
    actual = inventory(root)
    contents = {name: digest for name, digest in actual.items() if name != SNAPSHOT}
    if contents != manifest["files"] or (expected is not None and actual != expected):
        raise SystemExit(f"ERROR: snapshot verification failed (changed, missing, or extra files): {root}")
    return manifest


def seal_snapshot(root: Path, args: argparse.Namespace, **metadata) -> None:
    write_json(root / SNAPSHOT, {
        "schema_version": 1, "repository": args.hf_repo,
        "repository_commit": args.snapshot_commit,
        "layout": args.snapshot_layout,
        "conversion_name": args.conversion_name,
        **metadata, "files": inventory(root),
    })


@contextmanager
def publication_lock(destination: Path):
    destination.parent.mkdir(parents=True, exist_ok=True)
    lock = destination.parent / f".{destination.name}.lock"
    try:
        lock.mkdir()
    except FileExistsError as error:
        raise SystemExit(f"ERROR: snapshot is locked: {lock}; remove the empty lock only after confirming no writer is running") from error
    try:
        yield
    finally:
        lock.rmdir()


def dependency_records(args: argparse.Namespace) -> list[dict]:
    records = []
    for directory in args.base_model_dir:
        root = resolve_path(directory)
        manifest = verify_snapshot(root)
        records.append({"repository": manifest["repository"],
                        "repository_commit": manifest["repository_commit"],
                        "snapshot_sha256": sha256_file(root / SNAPSHOT)})
    return records


def assess_source(root: Path, info: dict, names: list[str], dependencies: list[dict]) -> dict:
    """Structural checks only: never load weights or execute repository code."""
    warnings = []
    selected = set(names)
    repo_files = {s["rfilename"] for s in info["siblings"]}
    omitted = sorted(repo_files - selected)
    if omitted:
        warnings.append("Filtered snapshot: some repository files were omitted.")
    # An index is a concrete dependency list, even for a filtered download.
    for name in names:
        if name.endswith((".safetensors.index.json", ".bin.index.json")):
            index = read_json(root / name)
            mapping = index.get("weight_map")
            if not isinstance(mapping, dict) or not mapping:
                raise SystemExit(f"ERROR: invalid weight index: {name}")
            for shard in mapping.values():
                if not isinstance(shard, str) or (Path(name).parent / shard).as_posix() not in selected:
                    raise SystemExit(f"ERROR: missing referenced weight shard in {name}: {shard}")
    source = infer_layout(names) == "source"
    config = read_json(root / "config.json") if "config.json" in selected else {}
    adapter = read_json(root / "adapter_config.json") if "adapter_config.json" in selected else {}
    if source:
        if "config.json" not in selected:
            warnings.append("No root config.json; architecture/runtime compatibility needs review.")
        if not any(Path(n).name in {"tokenizer.json", "tokenizer.model", "spiece.model", "vocab.json", "vocab.txt"} for n in names):
            warnings.append("No recognized tokenizer vocabulary; archive its external dependency if needed.")
        if not any(file_format(n)["model_kind"] == "source_format_weights" for n in names):
            warnings.append("No recognized source weight files.")
        if config.get("quantization_config"):
            warnings.append("Model declares quantization; prefer original released precision for new quantizations.")
        if adapter:
            warnings.append("Adapter repository: base weights must be archived separately; this is not a standalone model.")
    else:
        warnings.append("GGUF inference artifact; this is not a source checkpoint for new quantizations.")
    card = info.get("cardData") or info.get("card_data") or {}
    base = adapter.get("base_model_name_or_path") or card.get("base_model")
    bases = base if isinstance(base, list) else [base] if isinstance(base, str) else []
    archived_bases = {d["repository"]: d["repository_commit"] for d in dependencies}
    for base_id in bases:
        if base_id not in archived_bases:
            warnings.append(f"Declared base model has no explicitly archived dependency snapshot: {base_id}")
        elif adapter.get("revision") and adapter["revision"] != archived_bases[base_id]:
            warnings.append("Adapter base revision differs from archived commit or is an unresolved branch/tag.")
    if not any(Path(n).name.lower().startswith(("license", "copying")) for n in names):
        warnings.append("No license file found; review the model card and preserve applicable terms.")
    if not any(Path(n).name.lower() == "readme.md" for n in names):
        warnings.append("No model card README.md found.")
    return {"scope": "Structural checks only; original precision, external dependency completeness and converter support are unverified",
            "complete_repository": not omitted, "omitted_files": omitted,
            "architectures": config.get("architectures"), "declared_dtype": config.get("torch_dtype", config.get("dtype")),
            "quantization_config": config.get("quantization_config"),
            "declared_base_model": base, "declared_base_revision": adapter.get("revision"),
            "base_snapshots": dependencies, "warnings": warnings}


def publish_download(args: argparse.Namespace, paths: ArchivePaths, info: dict) -> None:
    names = selected_repo_files(info, args)
    request = {"repository": args.hf_repo, "commit": info["sha"], "files": names,
               "layout": args.snapshot_layout,
               "upstream_verification": not args.skip_upstream_verification,
               "base_snapshots": dependency_records(args)}
    with publication_lock(paths.local_model):
        if paths.local_model.exists():
            manifest = verify_snapshot(paths.local_model)
            if manifest.get("request") != request or args.force_download:
                raise SystemExit("ERROR: immutable snapshot already exists with different options; use a different model_name")
            if args.require_source_complete and manifest["source_assessment"]["warnings"]:
                raise SystemExit("ERROR: existing snapshot has source readiness warnings")
            print(f"Verified existing snapshot: {paths.local_model}")
        else:
            pending = paths.local_model.parent / f".{paths.local_model.name}.download-partial"
            if pending.is_symlink():
                raise SystemExit("ERROR: download staging directory must not be a symlink")
            marker = pending / PROVENANCE_DIR / "request.json"
            if pending.exists():
                if read_json(marker) != request:
                    raise SystemExit(f"ERROR: staging selection differs; preserve or move aside {pending}")
            else:
                pending.mkdir()
                write_json(marker, request)
            staged = replace(paths, local_model=pending)
            if not (pending / SNAPSHOT).exists():
                download_model(args, staged, info)
                assessment = assess_source(pending, info, names, request["base_snapshots"])
                for warning in assessment["warnings"]:
                    print(f"NOTICE: {warning}")
                if args.require_source_complete and assessment["warnings"]:
                    raise SystemExit("ERROR: source readiness checks failed; download remains staged")
                seal_snapshot(pending, args, request=request, source_assessment=assessment)
            manifest = verify_snapshot(pending)
            if args.require_source_complete and manifest["source_assessment"]["warnings"]:
                raise SystemExit("ERROR: staged snapshot has source readiness warnings")
            if paths.local_model.exists():
                raise SystemExit("ERROR: destination appeared during download")
            pending.rename(paths.local_model)
    ensure_checksums(paths.local_model, paths.local_checksum)


def download_model(args: argparse.Namespace, paths: ArchivePaths,
                   info: dict | None = None) -> dict[str, str]:
    require_command("hf")
    info = model_info(args) if info is None else info
    commit = info["sha"]
    names = selected_repo_files(info, args)
    if not names:
        raise SystemExit("ERROR: no repository files match the download filters")
    if any(name.split("/", 1)[0] in {PROVENANCE_DIR, ".cache"} for name in names):
        raise SystemExit("ERROR: repository uses reserved archive-provenance or .cache directory")
    endpoint = os.environ.get("HF_ENDPOINT", "https://huggingface.co").rstrip("/")
    parsed = urlsplit(endpoint)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc or parsed.username or parsed.password or parsed.query or parsed.fragment:
        raise SystemExit("ERROR: HF_ENDPOINT must be an HTTP(S) URL without credentials, query, or fragment")
    provenance_dir = paths.local_model / PROVENANCE_DIR
    if provenance_dir.is_symlink() or (provenance_dir.exists() and not provenance_dir.is_dir()):
        raise SystemExit(f"ERROR: expected a regular provenance directory: {provenance_dir}")
    paths.local_model.parent.mkdir(parents=True, exist_ok=True)

    print_section("Downloading Hugging Face model")
    print(f"Repository : {args.hf_repo}")
    print(f"Local      : {paths.local_model}")
    print()

    command = ["hf", "download", args.hf_repo, "--local-dir", str(paths.local_model)]

    command.extend(["--revision", commit])
    for pattern in args.include:
        command.extend(["--include", pattern])
    for pattern in args.exclude:
        command.extend(["--exclude", pattern])
    if args.force_download:
        command.append("--force-download")
    if args.limit:
        command.extend(["--max-workers", "1"])
    elif args.max_workers is not None:
        command.extend(["--max-workers", str(args.max_workers)])

    started_at = datetime.now(timezone.utc).isoformat()
    run_command(command)
    if not getattr(args, "skip_upstream_verification", False):
        verification = ["hf", "cache", "verify", args.hf_repo, "--revision", commit,
                        "--local-dir", str(paths.local_model)]
        if len(names) == len(info["siblings"]):
            verification.append("--fail-on-missing-files")
        run_command(verification)
    # CLI cache metadata is mutable and is not part of the portable snapshot.
    cache = paths.local_model / ".cache"
    if cache.is_symlink():
        raise SystemExit("ERROR: unexpected symlink in download cache")
    if cache.is_dir():
        shutil.rmtree(cache)
    if set(local_file_names(paths.local_model)) != set(names):
        raise SystemExit("ERROR: downloaded file set differs from the selected repository files")
    completed_at = datetime.now(timezone.utc).isoformat()
    return write_provenance(args, paths, info, names, endpoint, started_at, completed_at)


def model_info(args: argparse.Namespace) -> dict:
    """Use the CLI's authentication and endpoint settings, including cached login."""
    command = ["hf", "models", "info", args.hf_repo, "--revision", args.revision or "main",
               "--expand", "sha,siblings,cardData", "--format", "json"]
    result = subprocess.run(command, check=True, stdout=subprocess.PIPE, text=True)
    try:
        info = json.loads(result.stdout)
        if not re.fullmatch(r"[0-9a-fA-F]{40}", info["sha"]) or not isinstance(info["siblings"], list):
            raise ValueError("missing commit or file list")
    except (ValueError, KeyError, TypeError) as error:
        raise SystemExit("ERROR: hf models info did not return a valid commit and file list") from error
    return info


def selected_repo_files(info: dict, args: argparse.Namespace) -> list[str]:
    def matches(name: str, patterns: list[str]) -> bool:
        return any(fnmatchcase(name, p + "*" if p.endswith("/") else p) for p in patterns)

    names = []
    for sibling in info["siblings"]:
        name = sibling["rfilename"]
        if not name or name.startswith("/") or "\\" in name or any(p in {"", ".", ".."} for p in name.split("/")):
            raise SystemExit("ERROR: unsafe filename returned by Hugging Face")
        if (not args.include or matches(name, args.include)) and not matches(name, args.exclude):
            names.append(name)
    return sorted(set(names))


def file_format(name: str) -> dict:
    """Describe packaging without claiming every non-GGUF model is unquantized."""
    suffix = Path(name).suffix.lower()
    if suffix == ".gguf":
        quant = re.search(r"(?:^|[.\-_])((?:IQ|Q|TQ)\d[0-9A-Z_]*)(?=[.\-]|$)", Path(name).name.upper())
        return {"format": "gguf", "model_kind": "quantized_gguf" if quant else "gguf",
                "quantization": quant.group(1) if quant else None,
                "classification_basis": "filename; embedded tensor types not inspected"}
    if suffix in {".safetensors", ".bin", ".pt", ".pth", ".ckpt", ".h5", ".msgpack"}:
        return {"format": suffix[1:], "model_kind": "source_format_weights",
                "quantization": None,
                "classification_basis": "file extension; original-source and quantization status unverified"}
    return {"format": suffix[1:] or "unknown", "model_kind": "supporting_file"}


def write_provenance(args: argparse.Namespace, paths: ArchivePaths, info: dict,
                     names: list[str], endpoint: str, started_at: str, completed_at: str) -> dict[str, str]:
    print_section("Recording download provenance and SHA-256 hashes")
    source_url = f"{endpoint}/{quote(args.hf_repo, safe='/')}"
    files = []
    for name in names:
        path = paths.local_model / name
        if not path.is_file() or not path.resolve().is_relative_to(paths.local_model):
            raise SystemExit(f"ERROR: downloaded file missing or outside model directory: {name}")
        files.append({"path": name, "size_bytes": path.stat().st_size,
                      "sha256": sha256_file(path),
                      "source_url": f"{source_url}/resolve/{info['sha']}/{quote(name, safe='/')}",
                      **file_format(name)})
    kinds = sorted({f["model_kind"] for f in files if f["model_kind"] != "supporting_file"})
    card = info.get("cardData") or info.get("card_data") or {}
    manifest = {
        "schema_version": 1, "repository": args.hf_repo, "source_url": source_url,
        "requested_revision": args.revision or "main", "repository_commit": info["sha"],
        "revision_url": f"{source_url}/tree/{info['sha']}",
        "download_started_at": started_at, "download_completed_at": completed_at,
        "timestamp_note": "UTC interval for download and optional upstream verification; files may be reused from cache",
        "model_kinds": kinds or ["unknown"],
        "declared_base_model": card.get("base_model"),
        "declared_base_model_relation": card.get("base_model_relation"),
        "include": args.include, "exclude": args.exclude,
        "scope": "Only repository files selected in this invocation; excludes cache, provenance, and other pre-existing files",
        "files": files,
    }
    directory = paths.local_model / PROVENANCE_DIR
    directory.mkdir(exist_ok=True)
    # Retain earlier download records. Publish only complete manifests.
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=directory,
                                     prefix=".pending-", suffix=".tmp", delete=False) as output:
        pending = Path(output.name)
        try:
            json.dump(manifest, output, indent=2, ensure_ascii=False)
            output.write("\n")
        except BaseException:
            pending.unlink(missing_ok=True)
            raise
    final = directory / (pending.stem.replace(".pending-", "download-") + ".json")
    try:
        pending.replace(final)
    finally:
        pending.unlink(missing_ok=True)
    print(f"Provenance : {final}")
    return {file["path"]: file["sha256"] for file in files}


def sync_to_nas(args: argparse.Namespace, paths: ArchivePaths) -> None:
    if not resolve_path(args.nas_root).is_dir():
        raise SystemExit("ERROR: NAS root must already exist; mount or create the intended storage first")
    copy_snapshot(paths.local_model, paths.nas_model, paths.checksum)


def copy_snapshot(source: Path, destination: Path, checksum: Path) -> None:
    require_command("rsync")
    if source == destination or source.is_relative_to(destination) or destination.is_relative_to(source):
        raise SystemExit("ERROR: copy source and destination must be separate, non-overlapping directories")
    verify_snapshot(source)
    expected = inventory(source)
    with publication_lock(destination):
        if destination.exists():
            verify_snapshot(destination, expected)
        else:
            pending = destination.parent / f".{destination.name}.copy-partial"
            marker = destination.parent / f".{destination.name}.copy-request.json"
            if pending.is_symlink():
                raise SystemExit("ERROR: copy staging directory must not be a symlink")
            if pending.exists():
                if read_json(marker) != expected:
                    raise SystemExit(f"ERROR: different snapshot already staged at {pending}")
            else:
                # A marker may remain after an interrupted publication.
                if marker.exists() and read_json(marker) != expected:
                    raise SystemExit(f"ERROR: conflicting copy marker: {marker}")
                if not marker.exists():
                    write_json(marker, expected)
                pending.mkdir()
            print(f"Copying and verifying: {source} -> {destination}")
            # --checksum also repairs same-size/mtime corruption on a resumed copy.
            run_command(["rsync", "-avh", "--checksum", "--partial", f"{source}/", f"{pending}/"])
            verify_snapshot(pending, expected)
            verify_snapshot(source, expected)
            if destination.exists():
                raise SystemExit("ERROR: destination appeared during copy")
            pending.rename(destination)
            marker.unlink()
    ensure_checksums(destination, checksum)


def iter_files(root: Path) -> Iterable[Path]:
    if not root.is_dir() or root.is_symlink():
        raise SystemExit(f"ERROR: expected a regular snapshot directory: {root}")
    files = []
    for path in sorted(root.rglob("*")):
        if path.is_symlink() or not (path.is_file() or path.is_dir()):
            raise SystemExit(f"ERROR: snapshots must contain regular files/directories only: {path}")
        if path.is_file():
            files.append(path)
    return files


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as file:
        for chunk in iter(lambda: file.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def write_checksums(paths: ArchivePaths) -> None:
    verify_snapshot(paths.nas_model)
    ensure_checksums(paths.nas_model, paths.checksum)


def checksum_text(hashes: dict[str, str]) -> str:
    lines = []
    for relative, digest in sorted(hashes.items()):
        name = "./" + relative
        escaped = "\\" in name or "\n" in name
        name = name.replace("\\", "\\\\").replace("\n", "\\n")
        lines.append(("\\" if escaped else "") + f"{digest}  {name}\n")
    return "".join(lines)


def ensure_checksums(root: Path, destination: Path, require_existing: bool = False) -> None:
    content = checksum_text(inventory(root))
    if destination.exists():
        if destination.read_text(encoding="utf-8") != content:
            raise SystemExit(f"ERROR: saved checksum verification failed: {destination}")
    elif require_existing:
        raise SystemExit(f"ERROR: saved checksum file is missing: {destination}")
    else:
        destination.parent.mkdir(parents=True, exist_ok=True)
        with destination.open("x", encoding="utf-8") as output:
            output.write(content)


def create_local_archive(paths: ArchivePaths) -> None:
    verify_snapshot(paths.local_model)
    expected = inventory(paths.local_model)
    if paths.local_archive.is_relative_to(paths.local_model):
        raise SystemExit("ERROR: archive must be outside the model directory")
    if not str(paths.local_archive).endswith((".tar", ".tar.zst")):
        raise SystemExit("ERROR: archive path must end in .tar or .tar.zst")
    if paths.local_archive.exists():
        inspect_archive(paths.local_archive, expected)
        print(f"Verified existing archive: {paths.local_archive}")
        return
    paths.local_archive.parent.mkdir(parents=True, exist_ok=True)

    print_section("Creating local tar archive")
    print(f"Source  : {paths.local_model}")
    print(f"Archive : {paths.local_archive}")
    print()

    with tempfile.NamedTemporaryFile(
        dir=paths.local_archive.parent,
        prefix=f".{paths.local_archive.name}.",
        suffix=".tmp",
        delete=False,
    ) as temp_file:
        temp_archive = Path(temp_file.name)

    try:
        with temp_archive.open("wb") as output:
            compressor = None
            if str(paths.local_archive).endswith(".zst"):
                require_command("zstd")
                compressor = subprocess.Popen(["zstd", "-q", "-c"], stdin=subprocess.PIPE, stdout=output)
            try:
                with tarfile.open(fileobj=compressor.stdin if compressor else output,
                                  mode="w|", dereference=True) as tar:
                    tar.add(paths.local_model, arcname=paths.local_model.name)
                if compressor:
                    compressor.stdin.close()
                    if compressor.wait() != 0:
                        raise SystemExit("ERROR: zstd compression failed")
            finally:
                if compressor and compressor.poll() is None:
                    compressor.terminate()
                    compressor.wait()
        inspect_archive(temp_archive, expected, compressed=str(paths.local_archive).endswith(".zst"))
        verify_snapshot(paths.local_model, expected)
        # Hard-link publication cannot overwrite an existing archive, even in a race.
        os.link(temp_archive, paths.local_archive)
    finally:
        temp_archive.unlink(missing_ok=True)


def write_archive_checksum(paths: ArchivePaths) -> None:
    if not paths.local_archive.is_file():
        raise SystemExit(f"ERROR: local archive does not exist: {paths.local_archive}")

    paths.local_archive_checksum.parent.mkdir(parents=True, exist_ok=True)

    print_section("Generating archive SHA-256 checksum")
    print(f"Archive  : {paths.local_archive}")
    print(f"Checksum : {paths.local_archive_checksum}")
    print()

    inspect_archive(paths.local_archive)
    content = checksum_text({paths.local_archive.name: sha256_file(paths.local_archive)})
    if paths.local_archive_checksum.exists():
        if paths.local_archive_checksum.read_text(encoding="utf-8") != content:
            raise SystemExit("ERROR: archive checksum mismatch; refusing to replace baseline")
    else:
        with paths.local_archive_checksum.open("x", encoding="utf-8") as checksum_file:
            checksum_file.write(content)


def inspect_archive(path: Path, expected: dict[str, str] | None = None,
                    compressed: bool | None = None) -> dict:
    """Read every archived byte and validate the snapshot without extracting paths."""
    compressed = str(path).endswith(".zst") if compressed is None else compressed
    decompressor = None
    actual = {}
    manifest = None
    top = None
    with path.open("rb") as source:
        if compressed:
            require_command("zstd")
            decompressor = subprocess.Popen(["zstd", "-q", "-d", "-c"], stdin=source, stdout=subprocess.PIPE)
        stream = decompressor.stdout if decompressor else source
        try:
            with tarfile.open(fileobj=stream, mode="r|") as tar:
                for member in tar:
                    parts = member.name.split("/")
                    if any(p in {"", ".", ".."} for p in parts) or "\\" in member.name:
                        raise SystemExit("ERROR: unsafe archive path")
                    top = top or parts[0]
                    if parts[0] != top:
                        raise SystemExit("ERROR: archive contains multiple snapshot roots")
                    if member.isdir():
                        continue
                    if not member.isfile() or len(parts) < 2:
                        raise SystemExit("ERROR: archive contains a link or special file")
                    name = "/".join(parts[1:])
                    if name in actual:
                        raise SystemExit("ERROR: duplicate archive member")
                    digest = hashlib.sha256()
                    file = tar.extractfile(member)
                    if name == SNAPSHOT:
                        if member.size > 64 * 1024 * 1024:
                            raise SystemExit("ERROR: snapshot manifest exceeds 64 MiB")
                        data = file.read()
                        manifest = json.loads(data)
                        digest.update(data)
                    else:
                        for chunk in iter(lambda: file.read(1024 * 1024), b""):
                            digest.update(chunk)
                    actual[name] = digest.hexdigest()
            # Drain trailing tar padding so zstd can finish and validate its stream.
            while stream.read(1024 * 1024):
                pass
            if decompressor and decompressor.wait() != 0:
                raise SystemExit("ERROR: zstd archive verification failed")
        finally:
            if decompressor:
                stream.close()
                if decompressor.poll() is None:
                    decompressor.terminate()
                    decompressor.wait()
    contents = {n: h for n, h in actual.items() if n != SNAPSHOT}
    if (not isinstance(manifest, dict) or manifest.get("schema_version") != 1
            or not contents or contents != manifest.get("files")
            or (expected is not None and actual != expected)):
        raise SystemExit("ERROR: archive contents do not match the snapshot hashes")
    print(f"Verified archive contents: {path}")
    return manifest


def verify_archive(paths: ArchivePaths) -> None:
    content = checksum_text({paths.local_archive.name: sha256_file(paths.local_archive)})
    if paths.local_archive_checksum.read_text(encoding="utf-8") != content:
        raise SystemExit("ERROR: archive checksum verification failed")
    inspect_archive(paths.local_archive)


def prepare_conversion(args: argparse.Namespace) -> tuple[dict, dict[str, Path], Path]:
    recipe_path = resolve_path(args.record_conversion)
    recipe = read_json(recipe_path)
    required = {"name", "source_directory", "converter", "commands", "environment", "dependency_files", "calibration_files"}
    if set(recipe) != required:
        raise SystemExit(f"ERROR: conversion recipe must contain exactly: {', '.join(sorted(required))}")
    name = recipe["name"]
    converter = recipe["converter"]
    if (not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", name)
            or name == "download"
            or not isinstance(converter, dict) or not converter.get("repository")
            or not isinstance(converter.get("commit"), str)
            or not re.fullmatch(r"[0-9a-f]{40}", converter["commit"])):
        raise SystemExit("ERROR: recipe needs a simple name and converter repository/full commit SHA")
    commands = recipe["commands"]
    if (not isinstance(commands, list) or not commands
            or any(not isinstance(c, list) or not c or any(not isinstance(v, str) for v in c) for c in commands)
            or not isinstance(recipe["environment"], dict) or not recipe["environment"]):
        raise SystemExit("ERROR: recipe needs command argument arrays and a nonempty environment description")
    def input_path(value):
        if not isinstance(value, str) or not value:
            raise SystemExit("ERROR: recipe paths must be nonempty strings")
        return resolve_path(recipe_path.parent / Path(value).expanduser())
    source = input_path(recipe.pop("source_directory"))
    manifest = verify_snapshot(source)
    if manifest.get("conversion_name") or manifest["repository"] != args.hf_repo:
        raise SystemExit("ERROR: recipe source must be a source snapshot of the requested repository")
    if not any(file_format(n)["model_kind"] == "source_format_weights" for n in manifest["files"]):
        raise SystemExit("ERROR: recipe source has no source-format weights")
    if args.revision and args.revision != manifest["repository_commit"]:
        raise SystemExit("ERROR: --revision conflicts with recipe source")
    if args.conversion_name and args.conversion_name != name:
        raise SystemExit("ERROR: --conversion-name conflicts with recipe")
    args.snapshot_commit = manifest["repository_commit"]
    args.conversion_name = name
    recipe["source"] = {"repository": manifest["repository"], "repository_commit": args.snapshot_commit,
                        "snapshot_sha256": sha256_file(source / SNAPSHOT)}
    inputs = {f"{PROVENANCE_DIR}/source-snapshot.json": source / SNAPSHOT}
    for category in ("dependency_files", "calibration_files"):
        values = recipe[category]
        if not isinstance(values, list) or (category == "dependency_files" and not values):
            raise SystemExit("ERROR: dependency_files must be nonempty; calibration_files must be a list (possibly empty)")
        records = []
        for i, value in enumerate(values):
            file = input_path(value)
            if not file.is_file():
                raise SystemExit(f"ERROR: missing conversion input: {file}")
            target = f"{PROVENANCE_DIR}/conversion-inputs/{category}/{i}-{file.name}"
            inputs[target] = file
            records.append({"path": target, "sha256": sha256_file(file)})
        recipe[category] = records
    recipe["record_note"] = "User-reported conversion commands/environment; recorded, not executed or independently attested"
    outputs = resolve_path(args.local_model_dir)
    names = list(inventory(outputs))
    if any(n.split("/")[0] in {PROVENANCE_DIR, ".cache"} for n in names):
        raise SystemExit("ERROR: conversion output directory must not contain cache or archive provenance")
    if not any(n.endswith(".gguf") for n in names) or infer_layout(names) != "gguf":
        raise SystemExit("ERROR: conversion outputs must contain GGUF and no source-format weights")
    args.local_model_dir = None
    return recipe, inputs, outputs


def record_conversion(args: argparse.Namespace, paths: ArchivePaths,
                      recipe: dict, inputs: dict[str, Path], outputs: Path) -> None:
    expected = inventory(outputs)
    if outputs == paths.local_model or outputs.is_relative_to(paths.local_model) or paths.local_model.is_relative_to(outputs):
        raise SystemExit("ERROR: conversion outputs and archive destination must not overlap")
    request = {"recipe": recipe, "outputs": expected}
    with publication_lock(paths.local_model):
        if paths.local_model.exists():
            existing = verify_snapshot(paths.local_model)
            if existing.get("request") != request:
                raise SystemExit("ERROR: conversion name already exists with different contents or recipe")
        else:
            with tempfile.TemporaryDirectory(prefix=f".{args.conversion_name}.conversion-", dir=paths.local_model.parent) as work:
                pending = Path(work) / "snapshot"
                shutil.copytree(outputs, pending)
                if inventory(pending) != expected:
                    raise SystemExit("ERROR: GGUF outputs changed during import")
                for name, source in inputs.items():
                    destination = pending / name
                    destination.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(source, destination)
                for category in ("dependency_files", "calibration_files"):
                    for file in recipe[category]:
                        if sha256_file(pending / file["path"]) != file["sha256"]:
                            raise SystemExit("ERROR: conversion input changed during import")
                if sha256_file(pending / PROVENANCE_DIR / "source-snapshot.json") != recipe["source"]["snapshot_sha256"]:
                    raise SystemExit("ERROR: source manifest changed during import")
                write_json(pending / PROVENANCE_DIR / "conversion.json", recipe)
                seal_snapshot(pending, args, request=request)
                verify_snapshot(pending)
                if paths.local_model.exists():
                    raise SystemExit("ERROR: conversion destination appeared during import")
                pending.rename(paths.local_model)
    ensure_checksums(paths.local_model, paths.local_checksum)


def summarize(paths: ArchivePaths, stages: set[str]) -> None:
    print_section("Complete")
    stage_list = ", ".join(
        stage
        for stage in ("download", "conversion", "sync", "checksum", "backup", "archive", "archive_checksum", "verify", "verify_archive")
        if stage in stages
    )
    print(f"Stages   : {stage_list}")
    if "download" in stages or "sync" in stages or "archive" in stages:
        print(f"Local    : {paths.local_model}")
    if "conversion" in stages:
        print(f"Conversion : {paths.local_model}")
    if "download" in stages or "conversion" in stages:
        print(f"Local checksum : {paths.local_checksum}")
    if "sync" in stages or "checksum" in stages:
        print(f"Model    : {paths.nas_model}")
        print(f"Checksum : {paths.checksum}")
    if "archive" in stages or "archive_checksum" in stages:
        print(f"Archive  : {paths.local_archive}")
        print(f"Archive checksum : {paths.local_archive_checksum}")

    if ("sync" in stages or "checksum" in stages) and paths.nas_model.exists():
        du = shutil.which("du")
        if du is not None:
            sys.stdout.flush()
            subprocess.run([du, "-sh", str(paths.nas_model)], check=False)


def main() -> int:
    args = parse_args()
    stages = selected_stages(args)
    if "sync" in stages and not resolve_path(args.nas_root).is_dir():
        raise SystemExit("ERROR: NAS root must already exist; mount or create the intended storage first")
    model_name = args.model_name or default_model_name(args.hf_repo)
    info = None
    conversion = None
    if "download" in stages:
        require_command("hf")
        info = model_info(args)
        args.snapshot_commit = info["sha"].lower()
        if args.conversion_name:
            raise SystemExit("ERROR: --conversion-name is only for locally converted artifacts")
    elif "conversion" in stages:
        conversion = prepare_conversion(args)
    elif args.local_model_dir:
        manifest = verify_snapshot(resolve_path(args.local_model_dir))
        if manifest["repository"] != args.hf_repo or (args.revision and args.revision != manifest["repository_commit"]):
            raise SystemExit("ERROR: repository/revision does not match local snapshot")
        args.snapshot_commit = manifest["repository_commit"]
        if args.conversion_name and args.conversion_name != manifest.get("conversion_name"):
            raise SystemExit("ERROR: conversion name does not match local snapshot")
        args.conversion_name = manifest.get("conversion_name")
        if args.layout == "auto":
            args.layout = manifest["layout"]
        elif args.layout != manifest["layout"]:
            raise SystemExit("ERROR: layout does not match local snapshot")
    elif stages <= {"archive_checksum", "verify_archive"} and args.archive_path:
        args.snapshot_commit = "0" * 40  # Only the explicitly supplied archive path is used.
    layout = "gguf" if args.conversion_name else choose_layout(args, stages, model_name, info)
    if args.conversion_name and args.layout == "source":
        raise SystemExit("ERROR: local conversions use --layout gguf")
    args.snapshot_layout = layout
    paths = build_paths(args, model_name, layout)
    print(f"Layout   : {MODEL_LAYOUTS[layout]}")

    backup_paths = None
    if args.backup_root:
        backup_root = resolve_path(args.backup_root)
        for other in (resolve_path(args.nas_root), resolve_path(args.local_root)):
            if backup_root == other or backup_root.is_relative_to(other) or other.is_relative_to(backup_root):
                raise SystemExit("ERROR: backup root must be separate from local and NAS roots")
        if not backup_root.is_dir():
            raise SystemExit("ERROR: backup root must already exist; mount or create the intended storage first")
        backup_args = argparse.Namespace(**vars(args))
        backup_args.nas_root = backup_root
        backup_paths = build_paths(backup_args, model_name, layout)

    if "download" in stages:
        publish_download(args, paths, info)
    if conversion:
        record_conversion(args, paths, *conversion)
    if "sync" in stages:
        sync_to_nas(args, paths)
    if "checksum" in stages:
        write_checksums(paths)
    if backup_paths and stages & {"download", "conversion", "sync", "checksum", "archive"}:
        source = paths.local_model if paths.local_model.exists() else paths.nas_model
        copy_snapshot(source, backup_paths.nas_model, backup_paths.checksum)
        stages.add("backup")
        print(f"Verified backup: {backup_paths.nas_model}")
    if "archive" in stages:
        create_local_archive(paths)
    if "archive_checksum" in stages:
        write_archive_checksum(paths)
    if "verify_archive" in stages:
        verify_archive(paths)
    if "verify" in stages:
        root, checksum = {
            "local": (paths.local_model, paths.local_checksum),
            "nas": (paths.nas_model, paths.checksum),
            "backup": (backup_paths.nas_model, backup_paths.checksum) if backup_paths else (None, None),
        }[args.verify_target]
        verify_snapshot(root)
        ensure_checksums(root, checksum, require_existing=True)
        print(f"Verified snapshot and saved checksums: {root}")

    summarize(paths, stages)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as error:
        print(f"ERROR: command failed with exit code {error.returncode}: {error.cmd}", file=sys.stderr)
        raise SystemExit(error.returncode)
    except (OSError, ValueError, tarfile.TarError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(1)
